{
  "name": "photoman",
  "version": "1.0.0",
  "description": "PhotoMan - 本地图片管理应用",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"npm run dev:vite\" \"npm run dev:electron-start\"",
    "dev:vite": "vite",
    "dev:electron-start": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "tsc && vite build",
    "build:electron": "tsc -p electron/tsconfig.json && node scripts/post-build-electron.cjs",
    "build:all": "npm run build && npm run build:electron",
    "preview": "vite preview",
    "rebuild": "electron-rebuild",
    "dist": "npm run build:all && electron-builder",
    "dist:win": "npm run build:all && electron-builder --win",
    "dist:mac": "npm run build:all && electron-builder --mac",
    "dist:linux": "npm run build:all && electron-builder --linux",
    "lint": "eslint src electron --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src electron --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@ant-design/icons": "6.1.0",
    "@types/lodash": "4.17.20",
    "antd": "5.12.0",
    "better-sqlite3": "9.6.0",
    "chokidar": "3.6.0",
    "dayjs": "1.11.18",
    "exifr": "7.1.3",
    "i18next": "25.6.0",
    "lodash": "4.17.21",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "14.0.0",
    "react-router-dom": "6.21.0",
    "react-window": "2.2.2",
    "react-zoom-pan-pinch": "3.7.0",
    "sharp": "0.33.5",
    "zustand": "5.0.8"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "win32",
        "darwin",
        "linux"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    },
    "allowedDeprecatedVersions": {
      "inflight": "*",
      "glob": "*",
      "rimraf": "*"
    },
    "overrides": {
      "electron": "39.0.0"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@electron/rebuild"
      ]
    }
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.1",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/jest": "30.0.0",
    "@types/node": "24.9.2",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@types/react-router-dom": "5.3.3",
    "@types/react-window": "1.8.8",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "@vitejs/plugin-react": "5.1.0",
    "@vitest/ui": "4.0.4",
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "electron": "39.0.0",
    "electron-builder": "26.1.0",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "jsdom": "27.0.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "4.0.5",
    "wait-on": "9.0.1"
  }
}
