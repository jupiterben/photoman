{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "PhotoMan",
  "version": "1.0.0",
  "identifier": "com.photoman.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:11420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PhotoMan",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
