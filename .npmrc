# pnpm 配置文件

# 允许运行脚本（native 模块编译需要）
enable-pre-post-scripts=true

# Visual Studio 版本设置（使用 2022）
msvs_version=2022


registry=http://192.168.31.24:4873/

# Electron 二进制下载走 nginx 缓存代理
# npm 会将此值映射为 npm_config_electron_mirror
electron_mirror=http://192.168.31.24:8090/_electron/


# 对于 native 模块使用 shamefully-hoist
shamefully-hoist=true

# 允许自动安装 peer dependencies
auto-install-peers=true

# 严格的 peer dependencies
strict-peer-dependencies=false

# Node linker（对于 Electron 推荐使用 hoisted）
node-linker=hoisted

# 保留符号链接
preserve-symlinks=false

